# Copy to .env next to docker-compose.yml. Never commit the real file.
APP_DOMAIN=slides.intern
PREVIEW_DOMAIN=slides.intern
# Directory containing fullchain.pem and privkey.pem for slides.intern and *.slides.intern
TLS_DIR=./deploy/certs

# --- Login: AUTH_MODE=oidc (SSO via oauth2-proxy) or AUTH_MODE=local (own accounts, invited by an admin) ---
AUTH_MODE=oidc

# Promoted to admin when they sign in (never demoted; admins can also grant rights in Settings → People).
# local: on start, every address here without a password gets a one-time setup link in the app log.
ADMIN_EMAILS=admin@example.com

# oidc: also start oauth2-proxy. Remove this line for AUTH_MODE=local.
COMPOSE_FILE=docker-compose.yml:docker-compose.oidc.yml
OIDC_ISSUER_URL=https://sso.example.com/realms/main
OIDC_CLIENT_ID=slidango
OIDC_CLIENT_SECRET=change-me
OIDC_EMAIL_DOMAINS=example.com
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=change-me
# oidc, optional: only these email domains may use Slidango (comma-separated)
ALLOWED_EMAIL_DOMAINS=

# local: signs the session cookie, at least 32 characters: openssl rand -base64 48
AUTH_SECRET=
# local, optional: session length in days (default 30)
AUTH_SESSION_DAYS=30

POSTGRES_PASSWORD=change-me

# Assistant (any OpenAI-compatible endpoint); can also be set by admins in the UI.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# true if the model accepts images (briefing images are sent along)
LLM_VISION=false

# Preview processes (Slidev dev servers)
RUNNER_MAX_INSTANCES=15
RUNNER_IDLE_MINUTES=10

# deploy/backup.sh
BACKUP_DIR=./backups
BACKUP_KEEP=14
