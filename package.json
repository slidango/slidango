{
  "name": "slidango",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "theme:pack": "mkdir -p theme/dist && cd theme && npm pack --pack-destination dist"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vue-eslint-parser": "10.4.1"
  }
}
