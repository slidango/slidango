# Copy to .env next to docker-compose.yml. Never commit the real file.
APP_DOMAIN=slides.intern
PREVIEW_DOMAIN=slides.intern
# Directory containing fullchain.pem and privkey.pem for slides.intern and *.slides.intern
TLS_DIR=./deploy/certs

# --- Login: AUTH_MODE=oidc (SSO via oauth2-proxy) or AUTH_MODE=password (one shared password) ---
AUTH_MODE=oidc

# oidc: also start oauth2-proxy. Remove this line for AUTH_MODE=password.
COMPOSE_FILE=docker-compose.yml:docker-compose.oidc.yml
OIDC_ISSUER_URL=https://sso.example.com/realms/main
OIDC_CLIENT_ID=slidango
OIDC_CLIENT_SECRET=change-me
OIDC_EMAIL_DOMAINS=example.com
# openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=change-me
# oidc only: comma-separated admin e-mails
ADMIN_EMAILS=admin@example.com

# password: everyone logs in with name, e-mail and this password (at least 8 characters).
AUTH_PASSWORD=
# optional; logging in with this password instead grants admin rights (templates, assistant, previews).
AUTH_ADMIN_PASSWORD=
# signs the session cookie, at least 32 characters: openssl rand -base64 48
AUTH_SECRET=

POSTGRES_PASSWORD=change-me

# Assistant (any OpenAI-compatible endpoint); can also be set by admins in the UI.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# true if the model accepts images (briefing images are sent along)
LLM_VISION=false

# Preview processes (Slidev dev servers)
RUNNER_MAX_INSTANCES=15
RUNNER_IDLE_MINUTES=10

# deploy/backup.sh
BACKUP_DIR=./backups
BACKUP_KEEP=14
