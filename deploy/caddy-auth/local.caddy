handle {
	# AUTH_MODE=local: the app checks accounts itself (session cookie or API token).
	# It ignores these headers in this mode; dropping them anyway keeps a mode
	# switch from ever trusting client-supplied identities.
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Preferred-Username

	reverse_proxy app:3000
}
