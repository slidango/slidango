handle /oauth2/* {
	reverse_proxy oauth2-proxy:4180 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Uri {uri}
	}
}

# API tokens (MCP clients, scripts) cannot do the SSO login. Requests carrying a
# Slidango token skip forward_auth; the app authenticates them by the token alone.
# Identity headers are still dropped, so a token request can never claim a person.
@token {
	path /mcp /mcp/* /api/*
	header Authorization "Bearer sld_*"
}
handle @token {
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Preferred-Username
	reverse_proxy app:3000
}

# Signed out, the app domain still serves the start page with public decks: the app
# shell, the public builds (/p/), their listing and thumbnails (/api/public/) and the
# auth mode. Everything else under /api and /collab needs a session; without one it
# answers 401 (not a redirect), so the app can send people to the login itself.
@appApi {
	host {$APP_DOMAIN}
	path /api/* /collab /collab/*
	not path /api/public/* /api/auth/config
}
handle @appApi {
	route {
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Email
		request_header -X-Auth-Request-Preferred-Username

		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Preferred-Username
		}

		reverse_proxy app:3000
	}
}

@appOpen host {$APP_DOMAIN}
handle @appOpen {
	# No identity here, ever: the app treats these requests as signed out.
	request_header -X-Auth-Request-User
	request_header -X-Auth-Request-Email
	request_header -X-Auth-Request-Preferred-Username
	reverse_proxy app:3000
}

# Preview subdomains: SSO login first, then back to the preview.
handle {
	# `route` keeps this order. The app trusts X-Auth-Request-*, and
	# forward_auth only overwrites headers the auth response actually sets,
	# so client-supplied copies are dropped first.
	route {
		request_header -X-Auth-Request-User
		request_header -X-Auth-Request-Email
		request_header -X-Auth-Request-Preferred-Username

		forward_auth oauth2-proxy:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Preferred-Username

			@unauthenticated status 401
			handle_response @unauthenticated {
				redir * https://{$APP_DOMAIN}/oauth2/sign_in?rd={scheme}://{hostport}{uri}
			}
		}

		reverse_proxy app:3000
	}
}
